+}
diff --git a/frontend/src/app/shared/ui/campo/campo.ts b/frontend/src/app/shared/ui/campo/campo.ts
new file mode 100644
index 0000000..fcd5873
--- /dev/null
+++ b/frontend/src/app/shared/ui/campo/campo.ts
@@ -0,0 +1,82 @@
+import {
+  ChangeDetectionStrategy,
+  Component,
+  Directive,
+  booleanAttribute,
+  computed,
+  inject,
+  input,
+} from '@angular/core';
+import { Icono } from '../icono/icono';
+
+let siguienteId = 0;
+
+/**
+ * Campo de formulario: etiqueta visible + control + ayuda + error.
+ * El control proyectado lleva [appInput], que toma de este componente el id y las
+ * relaciones aria (describedby, invalid, required).
+ *
+ * <app-campo etiqueta="Precio de lista" prefijo="$" obligatorio [error]="errorPrecio()">
+ *   <input appInput="num" formControlName="precio" inputmode="decimal" />
+ * </app-campo>
+ *
+ * El texto de error dice qué pasó y cómo seguir ("El CUIT tiene 11 dígitos. Faltan 2.").
+ */
+@Component({
+  selector: 'app-campo',
+  imports: [Icono],
+  changeDetection: ChangeDetectionStrategy.OnPush,
+  host: { class: 'campo' },
+  templateUrl: './campo.html',
+})
+export class Campo {
+  readonly etiqueta = input.required<string>();
+  readonly ayuda = input<string | null>(null);
+  readonly error = input<string | null>(null);
+  readonly obligatorio = input(false, { transform: booleanAttribute });
+  readonly prefijo = input<string | null>(null);
+  readonly sufijo = input<string | null>(null);
+
+  private readonly base = `campo-${++siguienteId}`;
+  readonly idControl = `${this.base}-control`;
+  readonly idAyuda = `${this.base}-ayuda`;
+  readonly idError = `${this.base}-error`;
+
+  /** Ids a los que apunta aria-describedby del control. */
+  readonly describedBy = computed(() => {
+    const ids = [];
+    if (this.error()) ids.push(this.idError);
+    if (this.ayuda()) ids.push(this.idAyuda);
+    return ids.length ? ids.join(' ') : null;
+  });
+}
+
+/**
+ * Control nativo del sistema: input, select o textarea.
+ * `appInput="num"` alinea a la derecha con cifras tabulares (importes, cantidades).
+ * Funciona solo o dentro de <app-campo>.
+ */
+@Directive({
+  selector: 'input[appInput], select[appInput], textarea[appInput]',
+  host: {
+    '[class]': 'clases()',
+    '[attr.id]': 'id() ?? campo?.idControl ?? null',
+    '[attr.aria-describedby]': 'campo?.describedBy() ?? null',
+    '[attr.aria-invalid]': 'campo?.error() ? "true" : null',
+    '[attr.aria-required]': 'campo?.obligatorio() ? "true" : null',
+  },
+})
+export class InputCampo {
+  protected readonly campo = inject(Campo, { optional: true });
+
+  readonly variante = input<'' | 'num'>('', { alias: 'appInput' });
+  readonly tamanio = input<'sm' | 'md'>('md');
+  readonly id = input<string | null>(null);
+
+  protected readonly clases = computed(() => {
+    const c = ['input'];
+    if (this.variante() === 'num') c.push('input--num');
+    if (this.tamanio() === 'sm') c.push('input--sm');
+    return c.join(' ');
+  });
+}
diff --git a/frontend/src/app/shared/ui/dialogo/dialogo.ts b/frontend/src/app/shared/ui/dialogo/dialogo.ts
new file mode 100644
index 0000000..aa289ff
--- /dev/null
+++ b/frontend/src/app/shared/ui/dialogo/dialogo.ts
@@ -0,0 +1,140 @@
+import { DIALOG_DATA, Dialog, DialogRef } from '@angular/cdk/dialog';
+import { createGlobalPositionStrategy } from '@angular/cdk/overlay';
+import { ComponentType } from '@angular/cdk/portal';
+import {
+  ChangeDetectionStrategy,
+  Component,
+  Injectable,
+  Injector,
+  inject,
+  input,
+} from '@angular/core';
+import { Observable, map } from 'rxjs';
+import { Boton } from '../boton/boton';
+import { Icono } from '../icono/icono';
+
+export interface OpcionesConfirmacion {
+  titulo: string;
+  mensaje: string;
+  /** Texto del botón que confirma. Repite el verbo de la acción ("Discontinuar productos"). */
+  accion: string;
+  cancelar?: string;
+  /** Acción destructiva: botón rojo. */
+  peligro?: boolean;
+}
+
+let siguienteId = 0;
+
+@Component({
+  selector: 'app-confirmacion',
+  imports: [Boton, Icono],
+  changeDetection: ChangeDetectionStrategy.OnPush,
+  host: { class: 'modal' },
+  template: `
+    <div class="modal__cab">
+      <h2 class="modal__titulo" [id]="idTitulo">{{ datos.titulo }}</h2>
+      <button
+        appBoton="neutro"
+        tamanio="sm"
+        soloIcono
+        type="button"
+        aria-label="Cerrar"
+        (click)="ref.close(false)"
+      >
+        <app-icono nombre="cerrar" />
+      </button>
+    </div>
+    <p class="modal__cuerpo">{{ datos.mensaje }}</p>
+    <div class="modal__pie">
+      <button appBoton="secundario" type="button" (click)="ref.close(false)">
+        {{ datos.cancelar ?? 'Cancelar' }}
+      </button>
+      <button
+        [appBoton]="datos.peligro ? 'peligro' : 'primario'"
+        type="button"
+        (click)="ref.close(true)"
+      >
+        {{ datos.accion }}
+      </button>
+    </div>
+  `,
+})
+export class Confirmacion {
+  protected readonly datos = inject<OpcionesConfirmacion & { idTitulo: string }>(DIALOG_DATA);
+  protected readonly ref = inject<DialogRef<boolean>>(DialogRef);
+  protected readonly idTitulo = this.datos.idTitulo;
+}
+
+/**
+ * Estructura de un drawer lateral. El componente que se abre con
+ * DialogoService.abrirDrawer() la usa como raíz:
+ *
+ * <app-drawer titulo="Filtros">
+ *   ...campos
+ *   <ng-container drawer-pie><button appBoton="primario">Aplicar filtros</button></ng-container>
+ * </app-drawer>
+ */
+@Component({
+  selector: 'app-drawer',
+  imports: [Boton, Icono],
+  changeDetection: ChangeDetectionStrategy.OnPush,
+  host: { class: 'drawer' },
+  template: `
+    <div class="drawer__cab">
+      <h2 class="t-seccion" [id]="idTitulo">{{ titulo() }}</h2>
+      <button appBoton="neutro" soloIcono type="button" aria-label="Cerrar" (click)="ref.close()">
+        <app-icono nombre="cerrar" [tamanio]="18" />
+      </button>
+    </div>
+    <div class="drawer__cuerpo"><ng-content /></div>
+    <div class="drawer__pie"><ng-content select="[drawer-pie]" /></div>
+  `,
+})
+export class Drawer {
+  readonly titulo = input.required<string>();
+  protected readonly ref = inject(DialogRef);
+  readonly idTitulo = `drawer-titulo-${++siguienteId}`;
+}
+
+/**
+ * Superposiciones del sistema sobre @angular/cdk/dialog (foco atrapado,
+ * cierre con Esc, devolución del foco, scroll bloqueado).
+ */
+@Injectable({ providedIn: 'root' })
+export class DialogoService {
+  private readonly dialog = inject(Dialog);
+  private readonly injector = inject(Injector);
+
+  /** Modal de confirmación. Emite true si la persona confirma. */
+  confirmar(opciones: OpcionesConfirmacion): Observable<boolean> {
+    const idTitulo = `confirmacion-titulo-${++siguienteId}`;
+    const ref = this.dialog.open<boolean>(Confirmacion, {
+      data: { ...opciones, idTitulo },
+      ariaLabelledBy: idTitulo,
+      role: 'alertdialog',
+      backdropClass: 'fondo-overlay',
+      autoFocus: 'first-tabbable',
+    });
+    return ref.closed.pipe(map((r) => r === true));
+  }
+
+  /** Drawer lateral con un componente cuya raíz es <app-drawer>. */
+  abrirDrawer<C, D = unknown, R = unknown>(
+    componente: ComponentType<C>,
+    opciones: { data?: D; lado?: 'der' | 'izq'; etiqueta: string },
+  ): DialogRef<R, C> {
+    const lado = opciones.lado ?? 'der';
+    const posicion = createGlobalPositionStrategy(this.injector).top('0');
+    if (lado === 'der') posicion.right('0');
+    else posicion.left('0');
+    return this.dialog.open<R, D, C>(componente, {
+      data: opciones.data,
+      ariaLabel: opciones.etiqueta,
+      backdropClass: 'fondo-overlay',
+      panelClass: ['drawer-panel', `drawer-panel--${lado}`],
+      positionStrategy: posicion,
+      height: '100%',
+      autoFocus: 'first-tabbable',
+    });
+  }
+}
