+  it('conserva los segmentos de un padre sin miga en la URL de los hijos', async () => {
+    await router.navigateByUrl('/admin/usuarios/nuevo');
+    expect(servicio.items()).toEqual([
+      { label: 'Usuarios', url: '/admin/usuarios' },
