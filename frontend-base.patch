+<div class="campo__control campo__control--prefijo" cdkOverlayOrigin #origen="cdkOverlayOrigin">
+  <span class="campo__prefijo"><app-icono nombre="buscar" /></span>
+  <input
+    appInput
+    type="text"
+    role="combobox"
+    autocomplete="off"
+    [placeholder]="placeholder()"
+    [value]="texto()"
+    [disabled]="deshabilitado()"
+    [attr.aria-expanded]="abierto()"
+    [attr.aria-controls]="idLista"
+    aria-autocomplete="list"
+    [attr.aria-activedescendant]="abierto() && activa() >= 0 ? idOpcion(activa()) : null"
+    (input)="escribir($event)"
+    (keydown)="teclado($event)"
+    (focus)="abrir()"
+    (blur)="alSalir()"
+  />
+</div>
+
+<ng-template
+  cdkConnectedOverlay
+  [cdkConnectedOverlayOrigin]="origen"
+  [cdkConnectedOverlayOpen]="abierto()"
+  [cdkConnectedOverlayPositions]="posiciones"
+  [cdkConnectedOverlayMatchWidth]="true"
+  (overlayOutsideClick)="cerrar()"
+  (detach)="cerrar()"
+>
+  <ul class="lista-flotante" role="listbox" [id]="idLista" style="width: 100%">
+    @if (cargando()) {
+      <li class="lista-flotante__vacio" role="presentation">Buscando…</li>
+    } @else {
+      @for (op of opciones(); track $index; let i = $index) {
+        <li
+          role="option"
+          class="lista-flotante__opcion"
+          [id]="idOpcion(i)"
+          [class.lista-flotante__opcion--activa]="i === activa()"
+          [attr.aria-selected]="op.valor === valor()"
+          (mousedown)="$event.preventDefault()"
+          (click)="elegir(op)"
+        >
+          <span>{{ op.etiqueta }}</span>
+          @if (op.detalle) {
+            <span class="lista-flotante__detalle num">{{ op.detalle }}</span>
+          }
+        </li>
+      } @empty {
+        @if (!permitirCrear()) {
+          <li class="lista-flotante__vacio" role="presentation">
+            Sin coincidencias para «{{ texto() }}»
+          </li>
+        }
+      }
+      @if (mostrarCrear()) {
+        <li
+          role="option"
+          class="lista-flotante__opcion"
+          style="justify-content: flex-start; color: var(--botella-700)"
+          [id]="idOpcion(opciones().length)"
+          [class.lista-flotante__opcion--activa]="activa() === opciones().length"
+          aria-selected="false"
+          (mousedown)="$event.preventDefault()"
+          (click)="crearDesdeTexto()"
+        >
+          <app-icono nombre="mas" />
+          <span>Crear «{{ texto() }}»</span>
+        </li>
+      }
+    }
+  </ul>
+</ng-template>
diff --git a/frontend/src/app/shared/ui/autocompletar/autocompletar.ts b/frontend/src/app/shared/ui/autocompletar/autocompletar.ts
new file mode 100644
index 0000000..3e529a6
--- /dev/null
+++ b/frontend/src/app/shared/ui/autocompletar/autocompletar.ts
@@ -0,0 +1,173 @@
+import { CdkConnectedOverlay, CdkOverlayOrigin, ConnectedPosition } from '@angular/cdk/overlay';
+import {
+  ChangeDetectionStrategy,
+  Component,
+  booleanAttribute,
+  computed,
+  forwardRef,
+  input,
+  output,
+  signal,
+} from '@angular/core';
+import { ControlValueAccessor, NG_VALUE_ACCESSOR } from '@angular/forms';
+import { InputCampo } from '../campo/campo';
+import { Icono } from '../icono/icono';
+
+export interface OpcionAutocompletar<T> {
+  valor: T;
+  etiqueta: string;
+  /** Dato secundario a la derecha (por ejemplo, CUIT). */
+  detalle?: string;
+}
+
+let siguienteId = 0;
+
+const POSICIONES: ConnectedPosition[] = [
+  { originX: 'start', originY: 'bottom', overlayX: 'start', overlayY: 'top', offsetY: 4 },
+  { originX: 'start', originY: 'top', overlayX: 'start', overlayY: 'bottom', offsetY: -4 },
+];
+
+/**
+ * Autocompletar (combobox ARIA con lista). El filtrado lo hace quien lo usa:
+ * escucha (busqueda) —idealmente contra la API con debounce— y actualiza [opciones].
+ * Se integra con formularios reactivos (el valor es `valor` de la opción elegida).
+ *
+ * <app-campo etiqueta="Proveedor principal">
+ *   <app-autocompletar formControlName="proveedorId" [opciones]="proveedores()"
+ *     (busqueda)="buscarProveedores($event)" permitirCrear (crear)="altaProveedor($event)" />
+ * </app-campo>
+ */
+@Component({
+  selector: 'app-autocompletar',
+  imports: [CdkConnectedOverlay, CdkOverlayOrigin, InputCampo, Icono],
+  changeDetection: ChangeDetectionStrategy.OnPush,
+  providers: [
+    { provide: NG_VALUE_ACCESSOR, useExisting: forwardRef(() => Autocompletar), multi: true },
+  ],
+  host: { style: 'display: block; width: 100%' },
+  templateUrl: './autocompletar.html',
+})
+export class Autocompletar<T> implements ControlValueAccessor {
+  readonly opciones = input<OpcionAutocompletar<T>[]>([]);
+  readonly placeholder = input('Buscar');
+  readonly cargando = input(false, { transform: booleanAttribute });
+  /** Ofrece "Crear «texto»" al final de la lista. */
+  readonly permitirCrear = input(false, { transform: booleanAttribute });
+
+  readonly busqueda = output<string>();
+  readonly crear = output<string>();
+  readonly seleccion = output<OpcionAutocompletar<T>>();
+
+  protected readonly posiciones = POSICIONES;
+  protected readonly idLista = `autocompletar-${++siguienteId}`;
+  protected readonly texto = signal('');
+  protected readonly valor = signal<T | null>(null);
+  protected readonly abierto = signal(false);
+  protected readonly activa = signal(-1);
+  protected readonly deshabilitado = signal(false);
+
+  protected readonly mostrarCrear = computed(
+    () =>
+      this.permitirCrear() &&
+      this.texto().trim().length > 0 &&
+      !this.opciones().some((o) => o.etiqueta.toLowerCase() === this.texto().trim().toLowerCase()),
+  );
+
+  private readonly totalItems = computed(
+    () => this.opciones().length + (this.mostrarCrear() ? 1 : 0),
+  );
+
+  private alCambiar: (valor: T | null) => void = () => {};
+  private alTocar: () => void = () => {};
+
+  protected idOpcion(i: number): string {
+    return `${this.idLista}-op-${i}`;
+  }
+
+  protected abrir(): void {
+    if (!this.deshabilitado()) this.abierto.set(true);
+  }
+
+  protected cerrar(): void {
+    this.abierto.set(false);
+    this.activa.set(-1);
+  }
+
+  protected alSalir(): void {
+    this.alTocar();
+    this.cerrar();
+  }
+
+  protected escribir(evento: Event): void {
+    const texto = (evento.target as HTMLInputElement).value;
+    this.texto.set(texto);
+    this.activa.set(-1);
+    this.abierto.set(true);
+    if (this.valor() !== null) {
+      this.valor.set(null);
+      this.alCambiar(null);
+    }
+    this.busqueda.emit(texto);
+  }
+
+  protected teclado(evento: KeyboardEvent): void {
+    const total = this.totalItems();
+    switch (evento.key) {
+      case 'ArrowDown':
+        evento.preventDefault();
+        this.abierto.set(true);
+        if (total) this.activa.update((i) => (i + 1) % total);
+        break;
+      case 'ArrowUp':
+        evento.preventDefault();
+        if (total) this.activa.update((i) => (i <= 0 ? total - 1 : i - 1));
+        break;
+      case 'Enter': {
+        const i = this.activa();
+        if (!this.abierto() || i < 0) return;
+        evento.preventDefault();
+        if (i < this.opciones().length) this.elegir(this.opciones()[i]);
+        else this.crearDesdeTexto();
+        break;
+      }
+      case 'Escape':
+        if (this.abierto()) {
+          evento.preventDefault();
+          this.cerrar();
+        }
+        break;
+    }
+  }
+
+  protected elegir(op: OpcionAutocompletar<T>): void {
+    this.valor.set(op.valor);
+    this.texto.set(op.etiqueta);
+    this.alCambiar(op.valor);
+    this.seleccion.emit(op);
+    this.cerrar();
+  }
+
+  protected crearDesdeTexto(): void {
+    this.crear.emit(this.texto().trim());
+    this.cerrar();
+  }
+
+  // --- ControlValueAccessor -------------------------------------------------
+  writeValue(valor: T | null): void {
+    this.valor.set(valor ?? null);
+    const op = this.opciones().find((o) => o.valor === valor);
+    this.texto.set(op?.etiqueta ?? '');
+  }
+
+  registerOnChange(fn: (valor: T | null) => void): void {
+    this.alCambiar = fn;
+  }
+
+  registerOnTouched(fn: () => void): void {
+    this.alTocar = fn;
+  }
+
+  setDisabledState(deshabilitado: boolean): void {
+    this.deshabilitado.set(deshabilitado);
+  }
+}
diff --git a/frontend/src/app/shared/ui/boton/boton.ts b/frontend/src/app/shared/ui/boton/boton.ts
new file mode 100644
index 0000000..c2f4641
--- /dev/null
+++ b/frontend/src/app/shared/ui/boton/boton.ts
@@ -0,0 +1,39 @@
+import { Directive, booleanAttribute, computed, input } from '@angular/core';
+
+export type VarianteBoton = 'primario' | 'secundario' | 'terciario' | 'peligro' | 'neutro';
+export type TamanioBoton = 'sm' | 'md' | 'lg';
+
+/**
+ * Botón del sistema sobre el elemento nativo (button o a), para conservar
+ * la semántica y la accesibilidad del HTML.
+ *
+ * <button appBoton="primario" type="submit">Crear producto</button>
+ * <a appBoton="secundario" routerLink="/productos">Volver</a>
+ * <button appBoton="neutro" soloIcono aria-label="Más acciones"><app-icono nombre="mas-acciones" /></button>
+ *
+ * Regla: un solo botón primario por vista. El texto dice lo que pasa al tocarlo.
+ */
+@Directive({
+  selector: 'button[appBoton], a[appBoton]',
+  host: {
+    '[class]': 'clases()',
+    '[attr.aria-busy]': 'cargando() || null',
+    '[attr.aria-disabled]': 'cargando() || null',
+  },
+})
+export class Boton {
+  readonly variante = input<VarianteBoton, VarianteBoton | ''>('secundario', {
+    alias: 'appBoton',
+    transform: (v) => v || 'secundario',
+  });
+  readonly tamanio = input<TamanioBoton>('md');
+  readonly soloIcono = input(false, { transform: booleanAttribute });
+  readonly cargando = input(false, { transform: booleanAttribute });
+
+  protected readonly clases = computed(() => {
+    const c = ['btn', `btn--${this.variante()}`];
+    if (this.tamanio() !== 'md') c.push(`btn--${this.tamanio()}`);
+    if (this.soloIcono()) c.push('btn--icono');
+    return c.join(' ');
+  });
+}
