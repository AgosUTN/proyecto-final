+@use 'mixins' as m;
+
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+html {
+  -webkit-text-size-adjust: 100%;
+  text-size-adjust: 100%;
+}
+
+body {
+  margin: 0;
+  min-height: 100dvh;
+  background: var(--lienzo);
+  color: var(--carbon-900);
+  font: var(--t-cuerpo);
+  -webkit-font-smoothing: antialiased;
+  -moz-osx-font-smoothing: grayscale;
+}
+
+h1,
+h2,
+h3,
+h4,
+p,
+figure,
+dl,
+dd {
+  margin: 0;
+}
+
+h1,
+h2,
+h3,
+h4 {
+  font-weight: inherit;
+  font-size: inherit;
+}
+
+img,
+svg {
+  display: block;
+  max-width: 100%;
+}
+
+button,
+input,
+select,
+textarea {
+  font: inherit;
+  color: inherit;
+}
+
+a {
+  color: var(--botella-700);
+  text-underline-offset: 3px;
+
+  &:hover {
+    color: var(--botella-900);
+  }
+}
+
+:focus-visible {
+  @include m.foco-visible;
+}
+
+::selection {
+  background: var(--botella-100);
+}
+
+// Enlace para saltear la navegación con teclado.
+.saltar-contenido {
+  position: absolute;
+  left: var(--esp-4);
+  top: -100px;
+  z-index: 100;
+  padding: var(--esp-2) var(--esp-4);
+  background: var(--superficie);
+  border-radius: var(--r-sm);
+  box-shadow: var(--sombra-pop);
+  font: var(--t-cuerpo-medio);
+
+  &:focus {
+    top: var(--esp-3);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    transition-duration: 0.01ms !important;
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    scroll-behavior: auto !important;
+  }
+}
