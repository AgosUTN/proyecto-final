+// Fuentes alojadas en public/fonts (licencia SIL OFL 1.1, ver OFL-*.txt).
+// Solo subconjunto latin: cubre español, signos de moneda y el signo menos (U+2212).
+$rango-latin:
+  U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329,
+  U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
+
+// Newsreader variable (ejes opsz 6–72 y wght 200–800).
+@font-face {
+  font-family: 'Newsreader';
+  font-style: normal;
+  font-display: swap;
+  font-weight: 200 800;
+  src: url('/fonts/newsreader-latin-opsz-normal.woff2') format('woff2-variations');
+  unicode-range: $rango-latin;
+}
+
+@each $peso in (400, 500, 600) {
+  @font-face {
+    font-family: 'IBM Plex Sans';
+    font-style: normal;
+    font-display: swap;
+    font-weight: $peso;
+    src: url('/fonts/ibm-plex-sans-latin-#{$peso}-normal.woff2') format('woff2');
+    unicode-range: $rango-latin;
+  }
+}
diff --git a/frontend/src/styles/_mixins.scss b/frontend/src/styles/_mixins.scss
new file mode 100644
index 0000000..20911d7
--- /dev/null
+++ b/frontend/src/styles/_mixins.scss
@@ -0,0 +1,29 @@
+@use 'sass:map';
+
+// Breakpoints del sistema. Las media queries no aceptan var(), por eso viven acá.
+// Uso en componentes: @use 'mixins' as m;  @include m.hasta(md) { ... }
+$breakpoints: (
+  sm: 640px,
+  md: 960px,
+  lg: 1280px,
+  xl: 1600px,
+);
+
+// Pantallas menores al breakpoint indicado.
+@mixin hasta($bp) {
+  @media (max-width: (map.get($breakpoints, $bp) - 1px)) {
+    @content;
+  }
+}
+
+// Pantallas desde el breakpoint indicado.
+@mixin desde($bp) {
+  @media (min-width: map.get($breakpoints, $bp)) {
+    @content;
+  }
+}
+
+@mixin foco-visible {
+  outline: var(--anillo-foco);
+  outline-offset: 2px;
+}
